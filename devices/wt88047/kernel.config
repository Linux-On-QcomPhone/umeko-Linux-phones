# wt88047 kernel config fragment — merged on top of msm8916_defconfig by
# build_kernel.sh. Values follow the proven config used by the legacy
# KlipperPhonesLinux Redmi 2 images (6.7.0-rc4, LOCALVERSION -umeko-rv0).

# On-screen console (boot logs + getty on the phone display)
CONFIG_FRAMEBUFFER_CONSOLE=y



# SocketCAN + USB CAN adapters (gs_usb etc.) for 3D-printer toolboards,
# brought up by the autocanup service.
CONFIG_CAN=m
CONFIG_CAN_RAW=m
CONFIG_CAN_BCM=m
CONFIG_CAN_GS_USB=m

# RNDIS host side (use the phone as host for other USB gadgets)
CONFIG_USB_NET_RNDIS_HOST=m
