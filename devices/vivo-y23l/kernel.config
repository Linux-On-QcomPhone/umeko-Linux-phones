# vivo-y23l kernel config fragment — merged on top of msm8916_defconfig.

# Vivo Y23L (pd1419) panel drivers, from the device patch series
# (devices/vivo-y23l/kernel-patches/). The device ships with either panel;
# lk2nd/lk1st detects the actual one and rewrites the panel compatible in
# the dtb (match-panel), so both drivers must be present. =m follows the
# msm8916-generated panel convention (defconfig: DRM_PANEL_MSM8916_GENERATED=m).
CONFIG_DRM_PANEL_VIVO_NT35510S=m
CONFIG_DRM_PANEL_VIVO_ORISE8012A=m

# Reproducible kernelrelease: the device patches leave the kernel git tree
# dirty on purpose, so disable the SCM suffix (no "-dirty", no moving -g<hash>).
# The tree is pinned by the submodule + patches; the suffix adds nothing.
# CONFIG_LOCALVERSION_AUTO is not set
