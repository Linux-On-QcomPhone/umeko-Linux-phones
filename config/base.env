# Global build configuration (device-independent).
# Device-specific values live in devices/<codename>.env.

# Ubuntu base rootfs (arm64). Pin the point release; checksum is verified
# against the official SHA256SUMS at build time.
UBUNTU_BASE_URL="https://cdimage.ubuntu.com/ubuntu-base/releases/24.04/release/ubuntu-base-24.04.3-base-arm64.tar.gz"
UBUNTU_BASE_SHA256SUMS_URL="https://cdimage.ubuntu.com/ubuntu-base/releases/24.04/release/SHA256SUMS"

# Packages installed into the minimal rootfs (apt, --no-install-recommends).
ROOTFS_PACKAGES="locales tzdata sudo openssh-server network-manager kmod usbutils iputils-ping net-tools htop nano ca-certificates"

TIMEZONE="Asia/Shanghai"
LOCALE="en_US.UTF-8"
